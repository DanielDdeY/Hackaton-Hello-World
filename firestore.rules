rules_version = '2';

// MODO HACKATON: acceso totalmente abierto.
// Cualquier cliente (con o sin sesión) puede leer y escribir cualquier
// documento. No usar estas reglas en producción.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
