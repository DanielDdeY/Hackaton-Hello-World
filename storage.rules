rules_version = '2';

// MODO HACKATON: acceso totalmente abierto.
// Cualquier cliente (con o sin sesión) puede leer y subir archivos de
// cualquier ruta. No usar estas reglas en producción.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
