rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function communityMatches() {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.communityId == resource.metadata.communityId;
    }

    match /incident_photos/{uid}/{alertId}/{fileName} {
      allow read: if communityMatches();
      allow write: if owns(uid)
        && firestore.get(
          /databases/(default)/documents/emergency_alerts/$(alertId)
        ).data.reporterUid == request.auth.uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.communityId ==
          firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data.communityId;
    }
  }
}
